# node:24-alpine (Node 24.20.0, Alpine 3.24) — https://hub.docker.com/_/node
FROM node:24-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf

# Patch OS packages to clear known HIGH/CRITICAL vulns. Also remove the base-image-bundled
# npm/corepack entirely: they vendor a tar/ip-address with unfixed HIGH CVEs (CVE-2026-73566,
# CVE-2026-69192) that no current npm release has patched, and this project is yarn-only and
# never invokes npm — yarn itself ships independently of npm/corepack in this image — so
# removing them is safer than trying to patch or suppress vulnerabilities in code we never run.
RUN apk upgrade --no-cache \
    && NPM_DIR="$(npm root -g)" \
    && rm -rf "$NPM_DIR/npm" "$NPM_DIR/corepack" \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack

WORKDIR /usr/src/app

COPY ["*.json", "yarn.lock", "./"]

RUN yarn && yarn cache clean

COPY . .
RUN rm -rf ./views_euid
RUN rm -rf ./public/locales_euid
RUN mv ./views_uid2 ./views
RUN mv ./public/locales_uid2 ./public/locales
RUN rm ./public/images/EUID.png

RUN yarn build
RUN yarn lint

ENV ID_TYPE UID2

EXPOSE 3000
EXPOSE 9082
CMD [ "./build/bin/www" ]

